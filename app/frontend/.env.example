# Public frontend deployment. The Jenkins/frontend job builds app/frontend from
# the public repository, while Laravel lives in app/web.
NEXT_PUBLIC_APP_URL=
# Optional compatibility alias. Leave blank when LARAVEL_INTERNAL_API_ORIGIN and
# LARAVEL_CANONICAL_ORIGIN define the server/runtime and public origins.
LARAVEL_API_ORIGIN=
# Server-side Laravel origin reachable from the Next runtime, for example the
# internal Compose/Jenkins service URL. This value is not exposed to browsers.
LARAVEL_INTERNAL_API_ORIGIN=
# Browser-visible Laravel/application origin used when redirects or absolute
# URLs must remain public. Do not set it to an internal service hostname.
LARAVEL_CANONICAL_ORIGIN=
# Browser API base. Keep /api when the frontend reverse-proxies Laravel APIs.
NEXT_PUBLIC_LARAVEL_API_BASE_URL=
