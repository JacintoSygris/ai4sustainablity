# Frontend public template. Do not place secrets here: values prefixed with NEXT_PUBLIC_ are visible to the browser.
# For the included Compose profile, these values are supplied by compose.public.yml.

# Public URL of the frontend, for links and redirects in an own environment.
NEXT_PUBLIC_APP_URL=

# Server-to-server origin used by Next.js when it calls Laravel.
LARAVEL_API_ORIGIN=

# Browser-visible API base. In the public Compose profile this is normally /api through the frontend proxy.
NEXT_PUBLIC_LARAVEL_API_BASE_URL=
