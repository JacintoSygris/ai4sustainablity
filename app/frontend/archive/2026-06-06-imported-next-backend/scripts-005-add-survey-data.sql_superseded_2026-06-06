-- Create survey data table
CREATE TABLE IF NOT EXISTS surveyData (
  id TEXT PRIMARY KEY,
  reportId TEXT NOT NULL,
  companyName TEXT,
  sector TEXT,
  products TEXT,
  regions TEXT,
  employees TEXT,
  size TEXT,
  legalForm TEXT,
  createdAt INTEGER NOT NULL,
  updatedAt INTEGER NOT NULL,
  FOREIGN KEY (reportId) REFERENCES report(id)
);

CREATE INDEX IF NOT EXISTS idx_surveyData_reportId ON surveyData(reportId);
