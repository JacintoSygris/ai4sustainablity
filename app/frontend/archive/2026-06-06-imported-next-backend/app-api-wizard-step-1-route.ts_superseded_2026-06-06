import { NextResponse } from "next/server"
import { headers } from "next/headers"
import { assertLocalNextBackendEnabled } from "@/lib/local-next-backend"

async function getLocalBackend() {
  const [{ auth }, { getUserReport, saveSurveyData, markStepCompleted }] = await Promise.all([
    import("@/lib/auth"),
    import("@/lib/queries"),
  ])

  return { auth, getUserReport, saveSurveyData, markStepCompleted }
}

export async function POST(request: Request) {
  try {
    const localBackendDisabled = assertLocalNextBackendEnabled()

    if (localBackendDisabled) {
      return localBackendDisabled
    }

    const { auth, getUserReport, saveSurveyData, markStepCompleted } = await getLocalBackend()
    const session = await auth.api.getSession({
      headers: await headers(),
    })

    if (!session?.user) {
      return NextResponse.json({ error: "Unauthorized" }, { status: 401 })
    }

    const body = await request.json()
    const { companyName, sector, products, regions, employees, size, legalForm } = body

    const report = await getUserReport(session.user.id)
    if (!report) {
      return NextResponse.json({ error: "No report found" }, { status: 404 })
    }

    // Save survey data
    await saveSurveyData(report.id, {
      companyName,
      sector,
      products,
      regions,
      employees,
      size,
      legalForm,
    })

    // Mark step 1 as completed
    await markStepCompleted(report.id, 1)

    return NextResponse.json({ success: true })
  } catch (error) {
    console.error("Error saving survey data:", error)
    return NextResponse.json({ error: "Internal server error" }, { status: 500 })
  }
}
