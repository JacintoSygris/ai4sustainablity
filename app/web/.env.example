APP_NAME=IA4Sustainability
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
CACHE_STORE=database

MAIL_MAILER=log
MAIL_REQUIRE_TLS=true
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

AUTH_PUBLIC_REGISTRATION_ENABLED=false
AUTH_PASSWORD_RESET_ENABLED=false
AUTH_REQUIRE_EMAIL_VERIFICATION=true
TRUSTED_HOSTS=127.0.0.1,localhost
ENFORCE_TRUSTED_HOSTS=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=register

CHARACTERIZATION_GATEWAY=mock
CHARACTERIZATION_MOCK_OUTCOME=success
CHARACTERIZATION_API_BASE_URL=http://127.0.0.1:8001
CHARACTERIZATION_API_TOKEN=local-dev-token
CHARACTERIZATION_API_TIMEOUT=30
# Use new_format_732_v1_gpt41 for the activated 732-report model.
# Leave empty to let the Python service use its own default legacy_v0 profile.
CHARACTERIZATION_AI_MODEL_PROFILE=new_format_732_v1_gpt41
# Optional override. When empty, Laravel uses the 732 mapping automatically for new_format_732_v1_* profiles.
CHARACTERIZATION_PREDICTION_MAPPING_PATH=
CHARACTERIZATION_DEFAULT_COMPANY_NAME="Unknown company"
CHARACTERIZATION_DEFAULT_HEADQUARTERS_COUNTRY=Spain
CHARACTERIZATION_DEFAULT_REPORTING_CURRENCY=EUR
ESRS_MATTER_DR_MAPPING_PATH=

P6_DOCUMENT_UPLOAD_ENABLED=false
P6_AI_WORKER_TIMEOUT_SECONDS=180
P6_DOCUMENT_EXTRACT_TIMEOUT=240
P6_DOCUMENT_EXTRACT_JOB_TIMEOUT=300
P6_DOCUMENT_MAX_DOCUMENTS=5
P6_DOCUMENT_MAX_TOTAL_BYTES=262144000
P6_DOCUMENT_MAX_GLOBAL_BYTES=5368709120
P6_DOCUMENT_MAX_GLOBAL_DOCUMENTS=1000
P6_DOCUMENT_SCAN_ENABLED=false
P6_DOCUMENT_SCAN_BINARY=clamscan
P6_DOCUMENT_SCAN_TIMEOUT_SECONDS=30
P6_DOCUMENT_SCAN_MAX_CONCURRENT=2

# Private-dev auto-login is a local/operator fallback only.
# Keep it false on the Laravel-auth-only VPS and on any public or unprotected host.
PRIVATE_DEV_AUTO_LOGIN=false
PRIVATE_DEV_USER_EMAIL=private-dev-user@example.invalid
PRIVATE_DEV_USER_NAME="I4S Private Dev"

SOCIAL_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
MICROSOFT_TENANT_ID=common

VITE_APP_NAME="${APP_NAME}"
