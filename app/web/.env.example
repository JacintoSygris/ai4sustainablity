# Local development template. It is not the public Compose profile and is not a production configuration.
# Do not store real secrets in this file. Review docs/es-ES/technical/configuration.md before use.

APP_NAME=IA4Sustainability
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# mock avoids the proposal API during manual development. The public Compose profile uses api.
CHARACTERIZATION_GATEWAY=mock
CHARACTERIZATION_MOCK_OUTCOME=success
CHARACTERIZATION_API_BASE_URL=http://127.0.0.1:8001
CHARACTERIZATION_API_TOKEN=PLACEHOLDER_TOKEN
CHARACTERIZATION_API_TIMEOUT=30
CHARACTERIZATION_AI_MODEL_PROFILE=new_format_732_v1_gpt41
# Optional technical override. Leave empty unless you maintain the mapping deliberately.
CHARACTERIZATION_PREDICTION_MAPPING_PATH=
CHARACTERIZATION_DEFAULT_COMPANY_NAME="Unknown company"
CHARACTERIZATION_DEFAULT_HEADQUARTERS_COUNTRY=Spain
CHARACTERIZATION_DEFAULT_REPORTING_CURRENCY=EUR
# Optional topic-to-disclosure mapping. Empty means thematic coverage may remain in scoping mode.
ESRS_MATTER_DR_MAPPING_PATH=

SOCIAL_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
MICROSOFT_TENANT_ID=common

VITE_APP_NAME="${APP_NAME}"
