APP_NAME=IA4Sustainability
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

CHARACTERIZATION_GATEWAY=mock
CHARACTERIZATION_MOCK_OUTCOME=success
CHARACTERIZATION_API_BASE_URL=http://127.0.0.1:8001
CHARACTERIZATION_API_TOKEN=
CHARACTERIZATION_API_TIMEOUT=30
# Optional model profile when using a Python-backed gateway with local model artifacts.
CHARACTERIZATION_AI_MODEL_PROFILE=
# Optional override for prediction mapping path.
CHARACTERIZATION_PREDICTION_MAPPING_PATH=
CHARACTERIZATION_DEFAULT_COMPANY_NAME="Unknown company"
CHARACTERIZATION_DEFAULT_HEADQUARTERS_COUNTRY=Spain
CHARACTERIZATION_DEFAULT_REPORTING_CURRENCY=EUR
ESRS_MATTER_DR_MAPPING_PATH=

VITE_APP_NAME="${APP_NAME}"
