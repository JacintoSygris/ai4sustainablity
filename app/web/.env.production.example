APP_NAME=IA4Sustainability
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://i4s.ueporreres.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/home/ueporreres/domains/i4s.ueporreres.com/app/shared/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

CHARACTERIZATION_GATEWAY=mock
# Set CHARACTERIZATION_GATEWAY=api only for an intentional Python-backed
# production run after accepting the current P5 mapping/model caveats.
# CHARACTERIZATION_API_BASE_URL=http://127.0.0.1:8001
# CHARACTERIZATION_API_TOKEN=change-me-outside-repo
CHARACTERIZATION_API_TIMEOUT=30
CHARACTERIZATION_AI_MODEL_PROFILE=new_format_732_v1_gpt41
# Optional override. Empty means Laravel selects the 732 mapping automatically for new_format_732_v1_* profiles.
CHARACTERIZATION_PREDICTION_MAPPING_PATH=
ESRS_MATTER_DR_MAPPING_PATH=

PRIVATE_DEV_AUTO_LOGIN=false
PRIVATE_DEV_USER_EMAIL=i4sdev@i4s.local
PRIVATE_DEV_USER_NAME="I4S Dev"

VITE_APP_NAME="${APP_NAME}"
