APP_NAME=IA4Sustainability
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Browser-visible canonical origin used by password-reset and email-verification
# links. Do not set this to an internal IP, container host or Jenkins worker URL.
APP_URL=https://example.com
TRUSTED_HOSTS=example.com
# Effective hosts = TRUSTED_HOSTS + APP_URL host + INTERNAL_TRUSTED_HOSTS.
# Hosts efectivos = TRUSTED_HOSTS + host de APP_URL + INTERNAL_TRUSTED_HOSTS.
# Lowercase, unique; empty/example.com/app.example.org entries are discarded.
# En minúsculas, sin duplicados; se descartan vacíos/example.com/app.example.org.
INTERNAL_TRUSTED_HOSTS=web,localhost,127.0.0.1
ENFORCE_TRUSTED_HOSTS=true
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=sqlite
# Mount /var/www/html/storage as a persistent volume shared with the worker.
# Montar /var/www/html/storage como volumen persistente compartido con el worker.
DB_DATABASE=/var/www/html/storage/database/database.sqlite
# Destructive opt-in only; never enable for an ordinary deployment/restart.
# Opción destructiva; nunca activar en un despliegue/reinicio ordinario.
I4S_RESET_DATABASE_ON_START=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
CACHE_STORE=database

# Production email: a REAL transactional/SMTP provider is required so password
# reset and email verification actually reach users. Fill these on the VPS.
# (Postmark/SES/Mailgun expose SMTP; or swap MAIL_MAILER for their API driver.)
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.example
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_SCHEME=smtp
MAIL_REQUIRE_TLS=true
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Public-launch auth hardening (see config/services.php auth_hardening).
# Registration and reset stay OFF until mail/queue/Turnstile pass preflight.
AUTH_PUBLIC_REGISTRATION_ENABLED=false
AUTH_PASSWORD_RESET_ENABLED=false
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Cloudflare Turnstile (free bot protection). Get keys at dash.cloudflare.com.
# Public test keys may be used only in a disposable smoke environment; production
# must provide operator-owned keys through the deployment environment, not Git.
TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET=REPLACE_WITH_TURNSTILE_SECRET
# Must match the host part of APP_URL when registration is enabled.
TURNSTILE_EXPECTED_HOSTNAME=example.com
TURNSTILE_EXPECTED_ACTION=register

CHARACTERIZATION_GATEWAY=mock
# Set CHARACTERIZATION_GATEWAY=api only for an intentional Python-backed
# production run after accepting the current P5 mapping/model caveats.
# CHARACTERIZATION_API_BASE_URL=http://127.0.0.1:8001
# No leading/trailing whitespace: this is parsed as a URL by the Laravel adapter.
# CHARACTERIZATION_API_TOKEN=change-me-outside-repo
CHARACTERIZATION_API_TIMEOUT=30
CHARACTERIZATION_AI_MODEL_PROFILE=new_format_732_v1_gpt41
# Optional override. Empty means Laravel selects the 732 mapping automatically for new_format_732_v1_* profiles.
CHARACTERIZATION_PREDICTION_MAPPING_PATH=
ESRS_MATTER_DR_MAPPING_PATH=

# P6 upload stays OFF until ClamAV, the queue worker and the private AI service
# pass the deployment preflight. Production refuses uploads when scanning is off.
P6_DOCUMENT_UPLOAD_ENABLED=false
P6_AI_WORKER_TIMEOUT_SECONDS=180
P6_DOCUMENT_EXTRACT_TIMEOUT=240
P6_DOCUMENT_EXTRACT_JOB_TIMEOUT=300
P6_DOCUMENT_MAX_DOCUMENTS=5
P6_DOCUMENT_MAX_TOTAL_BYTES=262144000
P6_DOCUMENT_MAX_GLOBAL_BYTES=5368709120
P6_DOCUMENT_MAX_GLOBAL_DOCUMENTS=1000
P6_DOCUMENT_SCAN_ENABLED=false
P6_DOCUMENT_SCAN_BINARY=clamscan
P6_DOCUMENT_SCAN_TIMEOUT_SECONDS=30
P6_DOCUMENT_SCAN_MAX_CONCURRENT=2

# XHTML/iXBRL technical candidate. Obtain the authorised EFRAG ESRS Set 1 ZIP
# separately and keep both ZIP and manifest outside the repository, releases,
# Laravel base_path and storage_path. The private manifest records the package
# path, SHA-256 and matching ESRS 2023 profile; never commit either file.
ESRS_EXTERNAL_TAXONOMY_MANIFEST_PATH=
ESRS_ARELLE_COMMAND=

SOCIAL_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://example.com/auth/microsoft/callback
MICROSOFT_TENANT_ID=common

VITE_APP_NAME="${APP_NAME}"
