APP_NAME=IA4Sustainability
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Browser-visible canonical origin used by password-reset and email-verification
# links. Do not set this to an internal IP, container host or Jenkins worker URL.
APP_URL=https://example.com
TRUSTED_HOSTS=example.com
# Effective hosts = TRUSTED_HOSTS + APP_URL host + INTERNAL_TRUSTED_HOSTS.
# Hosts efectivos = TRUSTED_HOSTS + host de APP_URL + INTERNAL_TRUSTED_HOSTS.
# Lowercase, unique; empty/example.com/app.example.org entries are discarded.
# En minúsculas, sin duplicados; se descartan vacíos/example.com/app.example.org.
INTERNAL_TRUSTED_HOSTS=web,localhost,127.0.0.1
ENFORCE_TRUSTED_HOSTS=true
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=sqlite
# Mount /var/www/html/storage as a persistent volume shared with the worker.
# Montar /var/www/html/storage como volumen persistente compartido con el worker.
DB_DATABASE=/var/www/html/storage/database/database.sqlite
# Destructive opt-in only; never enable for an ordinary deployment/restart.
# Opción destructiva; nunca activar en un despliegue/reinicio ordinario.
I4S_RESET_DATABASE_ON_START=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
# Must exceed the longest job timeout. The optional learning worker runs with
# --timeout=1200, so keep 1800 (see the learning block below).
DB_QUEUE_RETRY_AFTER=1800
CACHE_STORE=database

# Production email: a REAL transactional/SMTP provider is required so password
# reset and email verification actually reach users. Fill these on the VPS.
# (Postmark/SES/Mailgun expose SMTP; or swap MAIL_MAILER for their API driver.)
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.example
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_SCHEME=smtp
MAIL_REQUIRE_TLS=true
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Public-launch auth hardening (see config/services.php auth_hardening).
# Registration and reset stay OFF until mail/queue/Turnstile pass preflight.
AUTH_PUBLIC_REGISTRATION_ENABLED=false
AUTH_PASSWORD_RESET_ENABLED=false
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Cloudflare Turnstile (free bot protection). Get keys at dash.cloudflare.com.
# Public test keys may be used only in a disposable smoke environment; production
# must provide operator-owned keys through the deployment environment, not Git.
TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET=REPLACE_WITH_TURNSTILE_SECRET
# Must match the host part of APP_URL when registration is enabled.
TURNSTILE_EXPECTED_HOSTNAME=example.com
TURNSTILE_EXPECTED_ACTION=register

CHARACTERIZATION_GATEWAY=mock
# Set CHARACTERIZATION_GATEWAY=api only for an intentional Python-backed
# production run after accepting the current P5 mapping/model caveats.
# CHARACTERIZATION_API_BASE_URL=http://127.0.0.1:8001
# No leading/trailing whitespace: this is parsed as a URL by the Laravel adapter.
# CHARACTERIZATION_API_TOKEN=change-me-outside-repo
CHARACTERIZATION_API_TIMEOUT=30
CHARACTERIZATION_AI_MODEL_PROFILE=new_format_732_v1_gpt41
# Optional override. Empty means Laravel selects the 732 mapping automatically for new_format_732_v1_* profiles.
CHARACTERIZATION_PREDICTION_MAPPING_PATH=
ESRS_MATTER_DR_MAPPING_PATH=

# P6 upload stays OFF until ClamAV, the queue worker and the private AI service
# pass the deployment preflight. Production refuses uploads when scanning is off.
P6_DOCUMENT_UPLOAD_ENABLED=false
P6_AI_WORKER_TIMEOUT_SECONDS=180
P6_DOCUMENT_EXTRACT_TIMEOUT=240
P6_DOCUMENT_EXTRACT_JOB_TIMEOUT=300
P6_DOCUMENT_MAX_DOCUMENTS=5
P6_DOCUMENT_MAX_TOTAL_BYTES=262144000
P6_DOCUMENT_MAX_GLOBAL_BYTES=5368709120
P6_DOCUMENT_MAX_GLOBAL_DOCUMENTS=1000
P6_DOCUMENT_SCAN_ENABLED=false
P6_DOCUMENT_SCAN_BINARY=clamscan
P6_DOCUMENT_SCAN_TIMEOUT_SECONDS=30
P6_DOCUMENT_SCAN_MAX_CONCURRENT=2

# XHTML/iXBRL technical candidate. Obtain the authorised EFRAG ESRS Set 1 ZIP
# separately and keep both ZIP and manifest outside the repository, releases,
# Laravel base_path and storage_path. The private manifest records the package
# path, SHA-256 and matching ESRS 2023 profile; never commit either file.
ESRS_EXTERNAL_TAXONOMY_MANIFEST_PATH=
ESRS_ARELLE_COMMAND=

# Optional supervised learning and feedback adjustment (consent only).
# Learning defaults to ON when APP_ENV=production or staging. This example keeps
# it OFF explicitly: set to true only after the provisioning checklist in
# app/docs/learning-activation-runbook.md is complete.
LEARNING_DEPLOYED=false
# Leave the commented variables below unset so they inherit the LEARNING_DEPLOYED
# defaults. An empty assignment (VAR=) is not "unset": it overrides the default.
# Promotion and rollback stay manual in /admin/learning; missing prerequisites
# keep learning blocked (fail closed) and are listed in that panel.
# LEARNING_ENGINE_ENABLED=true
# LEARNING_ENGINE_AUTHORITY=consent
# LEARNING_ENGINE_SYNTHETIC_ONLY=false
# LEARNING_ENGINE_SERVING_ENABLED=true
# LEARNING_ENGINE_SCHEDULED=true
# LEARNING_BANDIT_MODE=active
# Predeclared improvement gate: opt-in even when learning is deployed.
# LEARNING_GATE_METRICS_ENABLED=false
# LEARNING_GATE_MIN_COMPANIES=30
# LEARNING_GATE_MIN_POSITIVES=30
# LEARNING_GATE_MIN_NEGATIVES=30
# LEARNING_GATE_PRECISION_DELTA=0.01
# LEARNING_GATE_REPLICATES=2000
# LEARNING_GATE_CONFIDENCE=0.95
# LEARNING_GATE_SEED=17
# Public serving uses the existing services alias; other values fail closed.
# LEARNING_SERVING_RUNTIME=public
# Absolute, persistent, non-symlinked private directory outside the checkout,
# shared with the same path by the web app, the queue worker and the AI service,
# all running as the same OS user.
# LEARNING_ENGINE_ROOT=/absolute/persistent/path/learning-engine
# Python 3.13 environment built from app/ai-service/requirements-learning.lock.txt.
# Defaults: ../ai-service/src and ../ai-service/.venv-learning/bin/python.
# LEARNING_ENGINE_SOURCE=/absolute/path/to/app/ai-service/src
# LEARNING_ENGINE_PYTHON=/absolute/path/to/app/ai-service/.venv-learning/bin/python
# Full 40-character commit of the deployed checkout (for example $GIT_COMMIT).
# LEARNING_ENGINE_CODE_COMMIT=
# Held-out set (required to train and promote) and optional gold set: operator
# files kept outside Git and delivered by the deployment, with their SHA-256.
# LEARNING_ENGINE_HELDOUT_PATH=
# LEARNING_ENGINE_HELDOUT_SHA256=
# LEARNING_ENGINE_GOLD_PATH=
# LEARNING_ENGINE_GOLD_SHA256=
# Comma-separated numeric user IDs with a verified email. The panel reads
# LEARNING_ADMIN_USER_IDS (falling back to LEARNING_ENGINE_ADMIN_IDS); the
# learning:promote and learning:rollback commands read only
# LEARNING_ENGINE_ADMIN_IDS. Set both to the same IDs.
# LEARNING_ADMIN_USER_IDS=
# LEARNING_ENGINE_ADMIN_IDS=
# Learning also requires:
# - CHARACTERIZATION_GATEWAY=api with CHARACTERIZATION_API_BASE_URL=http://127.0.0.1:8001;
# - DB_QUEUE_RETRY_AFTER=1800 (set above);
# - a worker running: php artisan queue:work --queue=default,learning --timeout=1200 --tries=1
# - php artisan schedule:run every minute.
# The AI service reads LEARNING_DEPLOYED, LEARNING_ENGINE_ROOT and the same
# LEARNING_* flags from its own environment: keep them identical there.
# LEARNING_ENGINE_SHADOW_ENABLED is read only by the AI service and defaults to false.

# Optional modules. All are OFF by default; enable each one only after review.
# ADM CSV import (impacts, risks and opportunities, and stakeholder consultation).
# DMA_IMPORT_ENABLED=false
# Local text recommendations require reviewed IRO traceability and DMA import.
# DMA_NLP_ENABLED=false
# Python service (separate process environment; independent of learning):
# I4S_DMA_NLP_ENABLED=false
# I4S_DMA_NLP_MODEL_DIR=
# Generate the external package from the public catalogues; see app/docs/dma-import.md.
# Observational "often reported with" hints for ESRS topics and related datapoints.
# CONCEPT_RELATIONS_ENABLED=false
# Read-only sector comparison, independent of learning; both flags default OFF.
# SECTOR_COMPARISON_ENABLED=false
# Set these in the Python process environment, not only in this Laravel file.
# ESRS_SECTOR_COMPARISON_ENABLED=false
# External authorized JSON snapshot and its exact SHA-256; restart Python on change.
# ESRS_SECTOR_COMPARISON_PATH=
# ESRS_SECTOR_COMPARISON_SHA256=
# Reuses CHARACTERIZATION_API_BASE_URL/TOKEN and Python I4S_AI_API_TOKEN.
# Overlay of human-accepted XBRL concept suggestions on the concept map.
# XBRL_SUGGESTION_OVERLAY_ENABLED=false
# Runtime identification with human review; independent of learning and overlay.
# Set the flag independently in Laravel and Python (OFF in both by default).
# XBRL_RUNTIME_IDENTIFICATION_ENABLED=false
# Operator-provisioned manifest and optional catalog outside the repository (Laravel).
# XBRL_RUNTIME_MANIFEST_PATH=
# XBRL_RUNTIME_CATALOG_PATH=
# Python process only: absolute model directory; same manifest as Laravel.
# XBRL_RUNTIME_MODEL_DIR=
# Reuses CHARACTERIZATION_API_TOKEN / I4S_AI_API_TOKEN and numeric HTTP loopback.
# iXBRL report package and the reporting-period dates captured in the survey.
# IXBRL_PACKAGE_UI_ENABLED=false
# IXBRL_TAXONOMY_PROFILE=esrs_set1_2023-12-22
# Provisional 2026 draft profile (esrs_2026_draft_2026-08-30). It stays blocked
# even when enabled, because it has no concept mappings yet.
# IXBRL_2026_DRAFT_ENABLED=false
# Report scope identities and complete XHTML presentation. V1 needs new approval
# when enabled; existing V2 checks remain enforced after disabling this flag.
# REPORT_SCOPE_INTEGRITY_ENABLED=false
# Usability study kit; admin IDs are comma-separated numeric user IDs.
# USABILITY_STUDY_ENABLED=false
# USABILITY_STUDY_ADMIN_USER_IDS=
# EU Taxonomy eligibility screening (not alignment).
# EU_TAXONOMY_ELIGIBILITY_ENABLED=false
# Optional Arelle cache directory: absolute path outside the repository.
# ESRS_ARELLE_CACHE_DIRECTORY=

SOCIAL_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://example.com/auth/microsoft/callback
MICROSOFT_TENANT_ID=common

VITE_APP_NAME="${APP_NAME}"
