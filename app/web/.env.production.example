# Reference template for an operator-owned environment. It is not a complete production deployment.
# Replace every placeholder, use real secret management and review docs/es-ES/technical/deployment-boundaries.md.

APP_NAME=IA4Sustainability
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=info

# SQLite is kept only as a placeholder. Choose and operate a persistent database deliberately.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

AUTH_REQUIRE_EMAIL_VERIFICATION=true
TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET=REPLACE_WITH_TURNSTILE_SECRET

CHARACTERIZATION_GATEWAY=api
CHARACTERIZATION_API_BASE_URL=http://ai-service:8001
CHARACTERIZATION_API_TIMEOUT=30
CHARACTERIZATION_AI_MODEL_PROFILE=new_format_732_v1_gpt41
CHARACTERIZATION_PREDICTION_MAPPING_PATH=
# Configure only after methodological review. A configured path is not a compliance guarantee.
ESRS_MATTER_DR_MAPPING_PATH=

SOCIAL_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://example.com/auth/microsoft/callback
MICROSOFT_TENANT_ID=common

VITE_APP_NAME="${APP_NAME}"
