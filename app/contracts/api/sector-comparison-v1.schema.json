{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sector-comparison-v1.schema.json",
  "title": "Sector comparison v1",
  "oneOf": [
    {
      "$ref": "#/$defs/Artifact"
    },
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ],
  "$defs": {
    "SectorCounts": {
      "additionalProperties": false,
      "properties": {
        "n_scored": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "N Scored",
          "type": "integer"
        },
        "n_material": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "N Material",
          "type": "integer"
        }
      },
      "required": [
        "n_scored",
        "n_material"
      ],
      "title": "SectorCounts",
      "type": "object"
    },
    "SectorHashes": {
      "additionalProperties": false,
      "properties": {
        "labels": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Labels",
          "type": "string"
        },
        "masks": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Masks",
          "type": "string"
        },
        "companies": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Companies",
          "type": "string"
        },
        "encoding": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Encoding",
          "type": "string"
        },
        "topic_mapping": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Topic Mapping",
          "type": "string"
        }
      },
      "required": [
        "labels",
        "masks",
        "companies",
        "encoding",
        "topic_mapping"
      ],
      "title": "SectorHashes",
      "type": "object"
    },
    "SectorPeriod": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "title": "Start",
          "type": "string"
        },
        "end": {
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "SectorPeriod",
      "type": "object"
    },
    "SectorPopulation": {
      "additionalProperties": false,
      "properties": {
        "population_companies": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Population Companies",
          "type": "integer"
        },
        "topics": {
          "additionalProperties": {
            "$ref": "#/$defs/SectorCounts"
          },
          "title": "Topics",
          "type": "object",
          "minProperties": 89,
          "maxProperties": 89,
          "propertyNames": {
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6",
              "7",
              "8",
              "9",
